---
import {
  Box,
  Container,
  Typography,
  Card,
  CardContent,
  CardMedia,
  Link as MuiLink,
} from "@mui/material";
---

<Box
  component="section"
  aria-label="Latest news and resources section"
  sx={{
    backgroundColor: "white",
    paddingY: { xs: 6, md: 10 },
    paddingX: { xs: 2, md: 0 },
  }}
>
  <Container maxWidth="lg" client:load>
    {/* Header Section */}
    <Box
      component="header"
      sx={{
        textAlign: "center",
        marginBottom: { xs: 4, md: 6 },
      }}
    >
      <Typography
        component="h2"
        variant="h2"
        sx={{
          fontSize: { xs: "2rem", md: "2.5rem", lg: "3rem" },
          fontWeight: 700,
          color: "#1F2937",
          fontFamily: "sans-serif",
          marginBottom: 2,
        }}
      >
        Noticias y recursos de muebles
      </Typography>
      <Typography
        component="p"
        variant="body1"
        sx={{
          fontSize: { xs: "1rem", md: "1.125rem" },
          color: "#6B7280",
          fontFamily: "sans-serif",
          maxWidth: "700px",
          margin: "0 auto",
        }}
      >
        Conoce las últimas novedades y tendencias del sector del mobiliario
      </Typography>
    </Box>

    {/* Cards Grid Layout */}
    <Box
      component="div"
      sx={{
        display: "flex",
        flexDirection: { xs: "column", lg: "row" },
        gap: { xs: 3, md: 4 },
      }}
    >
      {/* Left Card - Large */}
      <Box
        component="div"
        sx={{
          flex: { lg: "1 1 60%" },
        }}
      >
        <Card
          sx={{
            borderRadius: "12px",
            boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
            height: "100%",
            display: "flex",
            flexDirection: "column",
            transition: "transform 0.2s, box-shadow 0.2s",
            "&:hover": {
              transform: "translateY(-4px)",
              boxShadow: "0 8px 12px rgba(0, 0, 0, 0.15)",
            },
          }}
        >
          <Box
            component="div"
            sx={{
              position: "relative",
              width: "100%",
              height: { xs: "250px", md: "350px" },
              overflow: "hidden",
            }}
          >
            <Box
              component="img"
              src="/image/muebel1.svg"
              alt="Furniture showcase"
              sx={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
              }}
            />
            <Box
              component="div"
              sx={{
                position: "absolute",
                bottom: 16,
                left: 16,
                backgroundColor: "#4ECDC4",
                color: "white",
                paddingX: 2,
                paddingY: 0.5,
                borderRadius: "6px",
                fontSize: "0.75rem",
                fontWeight: 600,
                fontFamily: "sans-serif",
              }}
            >
              NOTICIAS
            </Box>
          </Box>
          <CardContent
            sx={{
              padding: { xs: 2, md: 3 },
              display: "flex",
              flexDirection: "column",
              gap: 2,
              flex: 1,
            }}
          >
            <Typography
              component="h3"
              variant="h5"
              sx={{
                fontSize: { xs: "1.25rem", md: "1.5rem" },
                fontWeight: 700,
                color: "#1F2937",
                fontFamily: "sans-serif",
                lineHeight: 1.3,
              }}
            >
              Furniture Store adds $30 million to expand inventory with modern
              design solutions
            </Typography>
            <Typography
              component="p"
              variant="body1"
              sx={{
                fontSize: { xs: "0.9rem", md: "1rem" },
                color: "#6B7280",
                fontFamily: "sans-serif",
                lineHeight: 1.6,
              }}
            >
              Our furniture store, launched to revolutionize home and office
              spaces, integrates exclusively with modern design trends. We offer
              a comprehensive range of furniture solutions that combine style,
              functionality, and sustainability.
            </Typography>
            <MuiLink
              href="#"
              sx={{
                color: "#6B7280",
                fontSize: "0.9rem",
                fontFamily: "sans-serif",
                textDecoration: "underline",
                alignSelf: "flex-start",
                "&:hover": {
                  color: "#4ECDC4",
                },
              }}
            >
              Leer más
            </MuiLink>
          </CardContent>
        </Card>
      </Box>

      {/* Right Column - Three Smaller Cards */}
      <Box
        component="div"
        sx={{
          flex: { lg: "1 1 40%" },
          display: "flex",
          flexDirection: "column",
          gap: { xs: 3, md: 4 },
        }}
      >
        {/* Top Right Card */}
        <Card
          sx={{
            borderRadius: "12px",
            boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
            display: "flex",
            flexDirection: { xs: "column", sm: "row" },
            transition: "transform 0.2s, box-shadow 0.2s",
            "&:hover": {
              transform: "translateY(-4px)",
              boxShadow: "0 8px 12px rgba(0, 0, 0, 0.15)",
            },
          }}
        >
          <Box
            component="div"
            sx={{
              position: "relative",
              width: { xs: "100%", sm: "200px" },
              height: { xs: "180px", sm: "auto" },
              flexShrink: 0,
              overflow: "hidden",
            }}
          >
            <Box
              component="img"
              src="/image/mueble21.svg"
              alt="Furniture collection"
              sx={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
              }}
            />
            <Box
              component="div"
              sx={{
                position: "absolute",
                bottom: 12,
                left: 12,
                backgroundColor: "#4ECDC4",
                color: "white",
                paddingX: 1.5,
                paddingY: 0.5,
                borderRadius: "6px",
                fontSize: "0.7rem",
                fontWeight: 600,
                fontFamily: "sans-serif",
              }}
            >
              COMUNICADO
            </Box>
          </Box>
          <CardContent
            sx={{
              padding: { xs: 2, md: 2.5 },
              display: "flex",
              flexDirection: "column",
              gap: 1.5,
              flex: 1,
            }}
          >
            <Typography
              component="h3"
              variant="h6"
              sx={{
                fontSize: { xs: "1rem", md: "1.1rem" },
                fontWeight: 700,
                color: "#1F2937",
                fontFamily: "sans-serif",
                lineHeight: 1.3,
              }}
            >
              Furniture Store Closes $30 Million Series A Financing to Meet
              High Demand
            </Typography>
            <Typography
              component="p"
              variant="body2"
              sx={{
                fontSize: { xs: "0.85rem", md: "0.9rem" },
                color: "#6B7280",
                fontFamily: "sans-serif",
                lineHeight: 1.5,
              }}
            >
              Furniture Store, the company that created innovative furniture
              solutions, has successfully closed a $30 million Series A
              financing round to expand operations and meet growing customer
              demand.
            </Typography>
            <MuiLink
              href="#"
              sx={{
                color: "#6B7280",
                fontSize: "0.85rem",
                fontFamily: "sans-serif",
                textDecoration: "underline",
                alignSelf: "flex-start",
                "&:hover": {
                  color: "#4ECDC4",
                },
              }}
            >
              Leer más
            </MuiLink>
          </CardContent>
        </Card>

        {/* Middle Right Card */}
        <Card
          sx={{
            borderRadius: "12px",
            boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
            display: "flex",
            flexDirection: { xs: "column", sm: "row" },
            transition: "transform 0.2s, box-shadow 0.2s",
            "&:hover": {
              transform: "translateY(-4px)",
              boxShadow: "0 8px 12px rgba(0, 0, 0, 0.15)",
            },
          }}
        >
          <Box
            component="div"
            sx={{
              position: "relative",
              width: { xs: "100%", sm: "200px" },
              height: { xs: "180px", sm: "auto" },
              flexShrink: 0,
              overflow: "hidden",
            }}
          >
            <Box
              component="img"
              src="/image/mueble31.svg"
              alt="Modern furniture design"
              sx={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
              }}
            />
            <Box
              component="div"
              sx={{
                position: "absolute",
                bottom: 12,
                left: 12,
                backgroundColor: "#4ECDC4",
                color: "white",
                paddingX: 1.5,
                paddingY: 0.5,
                borderRadius: "6px",
                fontSize: "0.7rem",
                fontWeight: 600,
                fontFamily: "sans-serif",
              }}
            >
              NOTICIAS
            </Box>
          </Box>
          <CardContent
            sx={{
              padding: { xs: 2, md: 2.5 },
              display: "flex",
              flexDirection: "column",
              gap: 1.5,
              flex: 1,
            }}
          >
            <Typography
              component="h3"
              variant="h6"
              sx={{
                fontSize: { xs: "1rem", md: "1.1rem" },
                fontWeight: 700,
                color: "#1F2937",
                fontFamily: "sans-serif",
                lineHeight: 1.3,
              }}
            >
              Early investors are betting millions on sustainable furniture
              solutions
            </Typography>
            <Typography
              component="p"
              variant="body2"
              sx={{
                fontSize: { xs: "0.85rem", md: "0.9rem" },
                color: "#6B7280",
                fontFamily: "sans-serif",
                lineHeight: 1.5,
              }}
            >
              Sustainable furniture was never created to be a luxury product.
              Nonetheless, the industry has seen tremendous growth as consumers
              increasingly value eco-friendly and durable furniture options.
            </Typography>
            <MuiLink
              href="#"
              sx={{
                color: "#6B7280",
                fontSize: "0.85rem",
                fontFamily: "sans-serif",
                textDecoration: "underline",
                alignSelf: "flex-start",
                "&:hover": {
                  color: "#4ECDC4",
                },
              }}
            >
              Leer más
            </MuiLink>
          </CardContent>
        </Card>

        {/* Bottom Right Card */}
        <Card
          sx={{
            borderRadius: "12px",
            boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
            display: "flex",
            flexDirection: { xs: "column", sm: "row" },
            transition: "transform 0.2s, box-shadow 0.2s",
            "&:hover": {
              transform: "translateY(-4px)",
              boxShadow: "0 8px 12px rgba(0, 0, 0, 0.15)",
            },
          }}
        >
          <Box
            component="div"
            sx={{
              position: "relative",
              width: { xs: "100%", sm: "200px" },
              height: { xs: "180px", sm: "auto" },
              flexShrink: 0,
              overflow: "hidden",
            }}
          >
            <Box
              component="img"
              src="/image/mueble4.svg"
              alt="Furniture innovation"
              sx={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
              }}
            />
            <Box
              component="div"
              sx={{
                position: "absolute",
                bottom: 12,
                left: 12,
                backgroundColor: "#4ECDC4",
                color: "white",
                paddingX: 1.5,
                paddingY: 0.5,
                borderRadius: "6px",
                fontSize: "0.7rem",
                fontWeight: 600,
                fontFamily: "sans-serif",
              }}
            >
              NOTICIAS
            </Box>
          </Box>
          <CardContent
            sx={{
              padding: { xs: 2, md: 2.5 },
              display: "flex",
              flexDirection: "column",
              gap: 1.5,
              flex: 1,
            }}
          >
            <Typography
              component="h3"
              variant="h6"
              sx={{
                fontSize: { xs: "1rem", md: "1.1rem" },
                fontWeight: 700,
                color: "#1F2937",
                fontFamily: "sans-serif",
                lineHeight: 1.3,
              }}
            >
              Former Industry Leader Raises $16M to Bring Innovation to
              Furniture Design
            </Typography>
            <Typography
              component="p"
              variant="body2"
              sx={{
                fontSize: { xs: "0.85rem", md: "0.9rem" },
                color: "#6B7280",
                fontFamily: "sans-serif",
                lineHeight: 1.5,
              }}
            >
              This year, investors have reaped big financial returns from
              betting on innovative furniture companies. The market continues to
              show strong growth potential as design trends evolve.
            </Typography>
            <MuiLink
              href="#"
              sx={{
                color: "#6B7280",
                fontSize: "0.85rem",
                fontFamily: "sans-serif",
                textDecoration: "underline",
                alignSelf: "flex-start",
                "&:hover": {
                  color: "#4ECDC4",
                },
              }}
            >
              Leer más
            </MuiLink>
          </CardContent>
        </Card>
      </Box>
    </Box>
  </Container>
</Box>

